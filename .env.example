# Jira Cloud — API anahtarına yalnızca gerekli okuma izinlerini verin.
NEXTRACE_JIRA_BASE_URL=https://kurumunuz.atlassian.net
NEXTRACE_JIRA_EMAIL=kullanici@kurum.example
NEXTRACE_JIRA_API_TOKEN=buraya_jira_api_anahtari

# GitLab — read_api kapsamlı, süreli bir erişim anahtarı önerilir.
NEXTRACE_GITLAB_BASE_URL=https://gitlab.com
NEXTRACE_GITLAB_TOKEN=buraya_gitlab_erisim_anahtari

# İsteğe bağlı sınırlar
NEXTRACE_CONNECTOR_TIMEOUT=15
NEXTRACE_CONNECTOR_MAX_PAGES=10

# Yalnızca kurum içi/on-prem kaynaklar için bilinçli olarak etkinleştirin.
# NEXTRACE_ALLOW_PRIVATE_CONNECTORS=1

# Yalnızca yerel geliştirmede HTTP gerekiyorsa etkinleştirin.
# NEXTRACE_ALLOW_INSECURE_CONNECTORS=1
